{
  "$schema": "../schema.json",
  "version": 1,
  "name": "Private products",
  "defaultTarget": "app",
  "defaults": {
    "runner": "ubuntu-latest",
    "auth": "sources",
    "artifactKeySecret": "BUILDGRAPH_ARTIFACT_KEY",
    "env": {
      "CI": "true",
      "API_ORIGIN": "${{ vars.API_ORIGIN }}"
    }
  },
  "auth": {
    "sources": {
      "type": "app",
      "clientIdVariable": "SOURCE_APP_CLIENT_ID",
      "privateKeySecret": "SOURCE_APP_PRIVATE_KEY"
    }
  },
  "nodes": {
    "core": {
      "source": { "repository": "your-org/private-core", "ref": "main" },
      "steps": [
        { "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020", "with": { "node-version": "24" } },
        { "run": "npm ci\nnpm run build\ncp -R dist/. \"$BUILDGRAPH_OUTPUT/\"" }
      ],
      "output": {}
    },
    "app": {
      "needs": ["core"],
      "source": { "repository": "your-org/private-app", "ref": "main" },
      "steps": [
        { "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020", "with": { "node-version": "24" } },
        { "name": "Install the upstream build", "run": "mkdir -p vendor/core\ncp -R \"$BUILDGRAPH_INPUTS/core/.\" vendor/core/" },
        { "run": "npm ci\nnpm run build\ncp -R dist/. \"$BUILDGRAPH_OUTPUT/\"" }
      ],
      "output": {}
    },
    "publish": {
      "needs": ["app"],
      "environment": "production",
      "concurrency": "private-app-release",
      "permissions": { "contents": "write" },
      "steps": [
        {
          "name": "Publish application assets in this central repository",
          "env": {
            "GH_TOKEN": "${{ github.token }}",
            "RELEASE_TAG": "app-${{ github.run_id }}-${{ github.run_attempt }}"
          },
          "run": "tar -czf \"$RUNNER_TEMP/app.tar.gz\" -C \"$BUILDGRAPH_INPUTS/app\" .\ngh release create \"$RELEASE_TAG\" \"$RUNNER_TEMP/app.tar.gz\" --repo \"$GITHUB_REPOSITORY\" --target \"$GITHUB_SHA\" --title \"$RELEASE_TAG\" --notes \"Built by Buildgraph.\""
        }
      ]
    }
  }
}
