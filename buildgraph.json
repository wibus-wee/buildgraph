{
  "$schema": "./schema.json",
  "version": 1,
  "name": "Buildgraph demo",
  "defaultTarget": "bundle",
  "defaults": {
    "runner": "ubuntu-latest",
    "timeoutMinutes": 10,
    "env": { "BUILD_FLAVOR": "demo" }
  },
  "nodes": {
    "core": {
      "steps": [{ "name": "Build shared core", "run": "node examples/demo/build.mjs core" }],
      "output": {}
    },
    "web": {
      "needs": ["core"],
      "steps": [{ "name": "Build web with core", "run": "node examples/demo/build.mjs web" }],
      "output": {}
    },
    "cli": {
      "needs": ["core"],
      "steps": [{ "name": "Build CLI with core", "run": "node examples/demo/build.mjs cli" }],
      "output": {}
    },
    "bundle": {
      "needs": ["web", "cli"],
      "steps": [{ "name": "Assemble distributable", "run": "node examples/demo/build.mjs bundle" }],
      "output": { "visibility": "public", "retentionDays": 7 }
    },
    "independent": {
      "steps": [{ "name": "Independent target", "run": "node examples/demo/build.mjs independent" }],
      "output": { "visibility": "public" }
    }
  }
}
